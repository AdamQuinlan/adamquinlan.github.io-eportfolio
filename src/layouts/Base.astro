---
import '../styles/global.css';
import { site, u } from '../data/site';
import '../styles/folio.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.headline } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name}, ${site.role}`;
const path = (Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/\/$/, '') + '/').replace('//', '/');

const nav = [
  { href: '/', label: 'Home' },
  { href: '/hillview/', label: 'Capstone' },
  { href: '/teamwork/', label: 'Teamwork' },
  { href: '/built/', label: 'What I’ve built' },
  { href: '/why-woolloo/', label: 'Why woolloo' },
  { href: '/next/', label: 'What’s next' },
  { href: '/contact/', label: 'Contact' },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="robots" content="noindex" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={u("/favicon.svg")} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <script is:inline>
      // Apply the saved theme before the page paints, so there is no flash.
      try { if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <div class="brand-wrap">
          <a class="brand" href={u("/")}>{site.name}</a>
          <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Switch to dark mode">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path class="i-moon" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
              <g class="i-sun"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></g>
            </svg>
            <span class="t-label">Dark mode</span>
          </button>
        </div>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={u(item.href)} aria-current={(item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <p>{site.name}. An e-portfolio written in response to woolloo’s Graduate – AI, Data &amp; Product advertisement, for MQBS3010 at Macquarie University.</p>
        <ul>
          <li><a href={u("/contact/")}>Get in touch</a></li>
        </ul>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.querySelector('.theme-toggle');
        var label = btn.querySelector('.t-label');
        function sync() {
          var dark = root.dataset.theme === 'dark';
          btn.setAttribute('aria-pressed', String(dark));
          btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
          label.textContent = dark ? 'Light mode' : 'Dark mode';
        }
        btn.addEventListener('click', function () {
          var dark = root.dataset.theme !== 'dark';
          if (dark) root.dataset.theme = 'dark'; else delete root.dataset.theme;
          try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute; left: -999px; top: 0.5rem;
    background: var(--ink); color: var(--bg); padding: 0.5rem 1rem; z-index: 10;
  }
  .skip:focus { left: 0.5rem; }

  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(var(--bg-rgb), 0.8);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--line-soft);
  }
  .site-header, .brand, nav a { transition: background-color 0.3s, color 0.3s, border-color 0.3s; }
  :global(html.nav-dark) .site-header {
    background: rgba(22, 22, 23, 0.8);
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }
  :global(html.nav-dark) .brand,
  :global(html.nav-dark) nav a:hover { color: #f5f5f7; }
  :global(html.nav-dark) nav a { color: #a1a1a6; }
  .bar {
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.25rem 1rem; flex-wrap: wrap; padding-top: 0.7rem; padding-bottom: 0.7rem;
  }
  .brand-wrap { display: flex; align-items: center; gap: 0.75rem; }
  .theme-toggle {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.28rem 0.7rem 0.28rem 0.55rem; border-radius: 999px; cursor: pointer;
    font: inherit; font-size: 0.78rem; font-weight: 600;
    color: var(--ink); background: var(--surface); border: 1px solid var(--line);
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }
  .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
  .theme-toggle svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .theme-toggle .i-sun { display: none; }
  :global(:root[data-theme='dark']) .theme-toggle .i-sun { display: inline; }
  :global(:root[data-theme='dark']) .theme-toggle .i-moon { display: none; }
  :global(html.nav-dark) .theme-toggle { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.2); color: #f5f5f7; }
  @media (max-width: 22rem) { .t-label { display: none; } }
  .brand {
    font-family: var(--display); font-weight: 650; font-size: 1.05rem;
    color: var(--ink); text-decoration: none; letter-spacing: -0.01em;
  }
  nav ul { display: flex; gap: clamp(0.9rem, 3vw, 1.75rem); list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  nav a { color: var(--muted); text-decoration: none; font-weight: 450; font-size: 0.875rem; }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  @media (max-width: 30rem) {
    nav { width: 100%; overflow-x: auto; scrollbar-width: none; }
    nav::-webkit-scrollbar { display: none; }
    nav ul { gap: 0.75rem; flex-wrap: nowrap; }
    nav li { flex: none; }
    nav a { font-size: 0.78rem; }
  }
  nav a[aria-current='page'] { box-shadow: 0 2px 0 var(--accent); }
  nav a.cv-link { color: var(--on-accent); background: var(--accent); padding: 0.2rem 0.75rem; border-radius: 999px; font-weight: 600; }
  nav a.cv-link:hover { color: var(--on-accent); opacity: 0.9; }
  :global(html.nav-dark) nav a.cv-link { color: #04272b; background: #5fd0d9; }

  .site-footer { border-top: 1px solid var(--line); margin-top: 2rem; }
  .foot {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
    padding-top: 2rem; padding-bottom: 2.5rem; color: var(--muted); font-size: var(--step--1);
  }
  .foot p { margin: 0; }
  .foot ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
</style>
