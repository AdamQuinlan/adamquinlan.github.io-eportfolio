---
// A fictional fund factsheet, the kind of final output the master file produces.
// All names and figures are invented. Sizes are in em, so the whole sheet
// scales from the font-size set on it.
interface Props { size?: string; class?: string }
const { size = '10px', class: cls = '' } = Astro.props;

const sectors = [
  { name: 'Technology', w: 26, c: '#0b3d5c' },
  { name: 'Healthcare', w: 18, c: '#0b7a85' },
  { name: 'Financials', w: 16, c: '#48b8c2' },
  { name: 'Industrials', w: 14, c: '#9fd8dd' },
  { name: 'Consumer', w: 12, c: '#c98f0c' },
  { name: 'Other', w: 14, c: '#cfd3da' },
];
let acc = 0;
const conic = sectors.map((s) => { const a = acc; acc += s.w; return `${s.c} ${a}% ${acc}%`; }).join(', ');

const holdings = [
  ['Northwind Systems', 'Technology', '4.8'],
  ['Halvorsen Health', 'Healthcare', '4.1'],
  ['Corvel Software', 'Technology', '3.9'],
  ['Brightwater Utilities', 'Utilities', '3.2'],
  ['Aldane Industrial', 'Industrials', '2.9'],
];
const perf = [
  { p: '1M', f: 2.4, b: 1.9 },
  { p: '3M', f: 5.1, b: 4.4 },
  { p: '1Y', f: 12.6, b: 10.8 },
  { p: '3Y', f: 31.2, b: 27.5 },
];
const max = 31.2;
---
<div class={`fs ${cls}`} style={`font-size:${size}`}>
  <header class="fs-head">
    <div>
      <b>Example Global Equity Fund</b>
      <span>Monthly factsheet, March 2026</span>
    </div>
    <span class="fs-sample">Sample data</span>
  </header>

  <p class="fs-intro">
    The fund aims for long-term capital growth by investing in high-quality companies worldwide.
    Strong <span class="typo">perfomance</span> from technology and healthcare helped the fund return
    2.4% in March, ahead of its benchmark.
  </p>

  <div class="fs-kpis">
    <div><span>Fund size</span><b>$412m</b></div>
    <div class="k-hold"><span>Holdings</span><b>48</b></div>
    <div class="k-ret"><span>1M return</span><b>2.4%</b></div>
  </div>

  <div class="fs-row">
    <div class="fs-alloc">
      <span class="fs-label">Sector allocation</span>
      <div class="fs-pie-wrap">
        <div class="fs-pie" style={`background: conic-gradient(${conic})`}></div>
        <ul>
          {sectors.map((s) => <li><i style={`background:${s.c}`}></i>{s.name}<em>{s.w}%</em></li>)}
        </ul>
      </div>
    </div>
    <div class="fs-hold">
      <span class="fs-label">Top holdings</span>
      <table class="fs-table">
        <tbody>
          {holdings.map(([n, s, w]) => (
            <tr><td>{n}</td><td>{s}</td><td>{w}%<span class="tick" aria-hidden="true"></span></td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="fs-perf">
    <span class="fs-label">Performance vs benchmark (%)</span>
    <div class="fs-bars">
      {perf.map((r) => (
        <div class="fs-group">
          <div class="fs-pair">
            <i class="f" style={`--h:${(r.f / max) * 100}%`}></i>
            <i class="b" style={`--h:${(r.b / max) * 100}%`}></i>
          </div>
          <span>{r.p}</span>
        </div>
      ))}
    </div>
    <div class="fs-legend"><span><i class="f"></i>Fund</span><span><i class="b"></i>Benchmark</span></div>
  </div>
</div>

<style>
  .fs {
    background: #fff; color: #1d1d1f;
    line-height: 1.35;
    padding: 1.4em 1.5em;
    display: grid; gap: 1.1em;
    font-variant-numeric: tabular-nums;
  }
  .fs-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1em; border-bottom: 0.25em solid #0b3d5c; padding-bottom: 0.8em; }
  .fs-head b { display: block; font-size: 1.55em; letter-spacing: -0.02em; color: #0b3d5c; }
  .fs-head span { font-size: 1em; color: #6e6e73; }
  .fs-sample { background: #fbf0d4; color: #8a5f00 !important; font-weight: 600; padding: 0.2em 0.6em; border-radius: 999px; white-space: nowrap; }
  .fs-intro { margin: 0; font-size: 1.05em; color: #3a3a3c; max-width: none; }
  .typo { border-radius: 0.2em; transition: background 0.3s, box-shadow 0.3s; }
  .fs-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6em; }
  .fs-kpis div { background: #f2f5f8; border-radius: 0.5em; padding: 0.6em 0.8em; transition: box-shadow 0.3s, background 0.3s; }
  .fs-kpis span { display: block; color: #6e6e73; font-size: 0.9em; }
  .fs-kpis b { font-size: 1.5em; letter-spacing: -0.02em; color: #0b3d5c; }
  .fs-label { display: block; font-weight: 650; color: #0b3d5c; margin-bottom: 0.5em; font-size: 0.95em; }
  .fs-row { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 1.2em; }
  .fs-pie-wrap { display: flex; align-items: center; gap: 0.9em; }
  .fs-pie {
    flex: none; width: 6.4em; aspect-ratio: 1; border-radius: 50%;
    -webkit-mask: radial-gradient(circle, transparent 42%, #000 43%);
    mask: radial-gradient(circle, transparent 42%, #000 43%);
  }
  .fs-alloc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25em; flex: 1; min-width: 0; }
  .fs-alloc li { display: flex; align-items: center; gap: 0.45em; font-size: 0.9em; }
  .fs-alloc li i { width: 0.75em; height: 0.75em; border-radius: 0.15em; flex: none; }
  .fs-alloc li em { margin-left: auto; font-style: normal; color: #6e6e73; }
  .fs-hold { border-radius: 0.4em; transition: box-shadow 0.3s; }
  .fs-table { width: 100%; border-collapse: collapse; font-size: 0.92em; }
  .fs-table td { padding: 0.38em 0.3em; border-bottom: 1px solid #ececf0; white-space: nowrap; }
  .fs-table td:nth-child(2) { color: #6e6e73; }
  .fs-table td:last-child { text-align: right; position: relative; }
  .fs-table tr:nth-child(odd) td { background: #f8f9fb; }
  .tick { display: none; }
  .fs-bars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1em; height: 5.2em; align-items: end; }
  .fs-group { display: grid; grid-template-rows: 1fr auto; height: 100%; gap: 0.3em; }
  .fs-pair { display: flex; align-items: flex-end; justify-content: center; gap: 0.25em; }
  .fs-pair i { width: 1.1em; height: var(--h); border-radius: 0.15em 0.15em 0 0; }
  .fs-group span { text-align: center; color: #6e6e73; font-size: 0.85em; }
  i.f { background: #0b3d5c; }
  i.b { background: #9fd8dd; }
  .fs-legend { display: flex; gap: 1em; margin-top: 0.4em; font-size: 0.85em; color: #6e6e73; }
  .fs-legend i { display: inline-block; width: 0.7em; height: 0.7em; border-radius: 0.15em; margin-right: 0.35em; vertical-align: -0.05em; }
</style>
